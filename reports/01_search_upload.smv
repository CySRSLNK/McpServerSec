-- NuSMV model exported by ChainBreak
-- deployment=INJECT policy=naive states=21 bad=7
-- witness: search.search → envfs.read_file → upload.upload
MODULE main
  VAR state : 0..20;
  INIT state = 0;

  ASSIGN
    next(state) := case
      state = 0 : {0, 1, 2, 3};
      state = 1 : {1, 4, 5};
      state = 2 : {2, 6, 7, 8};
      state = 3 : {3, 5, 9, 10};
      state = 4 : {4, 6, 11, 12};
      state = 5 : {5, 13, 14};
      state = 6 : {4, 6, 15, 16};
      state = 7 : {7, 9, 15, 17};
      state = 8 : {2, 7, 8, 16};
      state = 9 : {7, 9, 17, 18};
      state = 10 : {3, 9, 10, 14};
      state = 11 : {11, 13, 15, 19};
      state = 12 : {4, 11, 12, 16};
      state = 13 : {11, 13, 18, 19};
      state = 14 : {5, 13, 14};
      state = 15 : {13, 15, 20};
      state = 16 : {4, 15, 16};
      state = 17 : {7, 9, 17, 20};
      state = 18 : {13, 15, 18, 20};
      state = 19 : {11, 13, 19, 20};
      state = 20 : {13, 15, 20};
      TRUE : state;
    esac;

  -- 违反安全属性的状态
  DEFINE bad := state = 8 | state = 10 | state = 12 | state = 14 | state = 17 | state = 19 | state = 20;

  -- 组合安全性质：永远不进入 bad
  CTLSPEC AG !bad;
