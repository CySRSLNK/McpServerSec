-- NuSMV model exported by ChainBreak
-- deployment=CUSTOM policy=naive states=8 bad=2
-- witness: feed.pull → post.publish
MODULE main
  VAR state : 0..7;
  INIT state = 0;

  ASSIGN
    next(state) := case
      state = 0 : {0, 1, 2};
      state = 1 : {1, 3};
      state = 2 : {2, 4, 5};
      state = 3 : {3, 4, 6};
      state = 4 : {3, 4, 7};
      state = 5 : {2, 5, 7};
      state = 6 : {3, 6, 7};
      state = 7 : {3, 7};
      TRUE : state;
    esac;

  -- 违反安全属性的状态
  DEFINE bad := state = 5 | state = 6;

  -- 组合安全性质：永远不进入 bad
  CTLSPEC AG !bad;
