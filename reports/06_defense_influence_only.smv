-- NuSMV model exported by ChainBreak
-- deployment=INJECT policy=influence-only states=17 bad=3
-- witness: envfs.read_file → upload.upload
MODULE main
  VAR state : 0..16;
  INIT state = 0;

  ASSIGN
    next(state) := case
      state = 0 : {0, 1, 2, 3};
      state = 1 : {1, 4, 5};
      state = 2 : {2, 6, 7};
      state = 3 : {3, 5, 8, 9};
      state = 4 : {4, 6, 10};
      state = 5 : {5, 11, 12};
      state = 6 : {4, 6, 13, 14};
      state = 7 : {7, 8, 13};
      state = 8 : {7, 8, 15};
      state = 9 : {3, 8, 9, 12};
      state = 10 : {10, 11, 13};
      state = 11 : {10, 11, 15};
      state = 12 : {5, 11, 12};
      state = 13 : {11, 13, 16};
      state = 14 : {4, 13, 14};
      state = 15 : {11, 13, 15, 16};
      state = 16 : {11, 13, 16};
      TRUE : state;
    esac;

  -- 违反安全属性的状态
  DEFINE bad := state = 9 | state = 12 | state = 16;

  -- 组合安全性质：永远不进入 bad
  CTLSPEC AG !bad;
