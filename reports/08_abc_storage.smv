-- NuSMV model exported by ChainBreak
-- deployment=ABC policy=naive states=22 bad=2
-- witness: docs.read_file → staging.write_file → egress.send_file
MODULE main
  VAR state : 0..21;
  INIT state = 0;

  ASSIGN
    next(state) := case
      state = 0 : {0, 1, 2, 3};
      state = 1 : {1, 4, 5};
      state = 2 : {2, 4, 6, 7, 8};
      state = 3 : {3, 5, 9, 10};
      state = 4 : {4, 11, 12, 13};
      state = 5 : {5, 14, 15};
      state = 6 : {6, 7, 9, 11, 16};
      state = 7 : {6, 7, 12, 17, 18};
      state = 8 : {2, 6, 7, 8, 13};
      state = 9 : {6, 7, 9, 14, 16};
      state = 10 : {3, 9, 10, 15};
      state = 11 : {11, 12, 14, 19};
      state = 12 : {11, 12, 20, 21};
      state = 13 : {4, 11, 12, 13};
      state = 14 : {11, 12, 14, 19};
      state = 15 : {5, 14, 15};
      state = 16 : {6, 7, 9, 16, 19};
      state = 17 : {6, 7, 17, 18, 20};
      state = 18 : {6, 7, 17, 18, 21};
      state = 19 : {11, 12, 14, 19};
      state = 20 : {11, 12, 20, 21};
      state = 21 : {11, 12, 20, 21};
      TRUE : state;
    esac;

  -- 违反安全属性的状态
  DEFINE bad := state = 18 | state = 21;

  -- 组合安全性质：永远不进入 bad
  CTLSPEC AG !bad;
